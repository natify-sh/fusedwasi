;; A WASI 0.2 command as one core module with a memory and a `cabi_realloc` (the shape of a module fused from components). It writes its arguments, one to a line, then
;; its environment as NAME=VALUE lines, then "t" if the monotonic clock is not zero, then "bye", and ends with wasi:cli/exit(err), which is status 1.
;; Written by hand for the tests of tests/neutral; it knows nothing of fusedwasi or of the engine that runs it. `p2_command.component.wat` is the same module as a component (see there).
(module
  (import "wasi:cli/environment@0.2.6" "get-arguments" (func $get_arguments (param i32)))
  (import "wasi:cli/environment@0.2.6" "get-environment" (func $get_environment (param i32)))
  (import "wasi:cli/stdout@0.2.6" "get-stdout" (func $get_stdout (result i32)))
  (import "wasi:io/streams@0.2.6" "[method]output-stream.blocking-write-and-flush" (func $write_and_flush (param i32 i32 i32 i32)))
  (import "wasi:io/streams@0.2.6" "[resource-drop]output-stream" (func $drop_output (param i32)))
  (import "wasi:clocks/monotonic-clock@0.2.6" "now" (func $now (result i64)))
  (import "wasi:cli/exit@0.2.6" "exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "\n")
  (data (i32.const 16) "=")
  (data (i32.const 32) "bye\n")
  (data (i32.const 48) "t\n")
  (global $heap (mut i32) (i32.const 8192))

  (func (export "cabi_realloc") (param $old_ptr i32) (param $old_size i32) (param $align i32) (param $new_size i32) (result i32)
    (local $ptr i32)
    (if (i32.eqz (local.get $new_size)) (then (return (local.get $align))))
    (local.set $ptr (i32.and (i32.add (global.get $heap) (i32.sub (local.get $align) (i32.const 1)))
                             (i32.xor (i32.sub (local.get $align) (i32.const 1)) (i32.const -1))))
    (global.set $heap (i32.add (local.get $ptr) (local.get $new_size)))
    (local.get $ptr))

  (func $write (param $out i32) (param $ptr i32) (param $len i32)
    (call $write_and_flush (local.get $out) (local.get $ptr) (local.get $len) (i32.const 96)))

  (func $main
    (local $out i32) (local $list i32) (local $count i32) (local $i i32) (local $entry i32)
    (local.set $out (call $get_stdout))
    (call $get_arguments (i32.const 64))
    (local.set $list (i32.load (i32.const 64)))
    (local.set $count (i32.load (i32.const 68)))
    (local.set $i (i32.const 0))
    (block $done (loop $each
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $entry (i32.add (local.get $list) (i32.shl (local.get $i) (i32.const 3))))
      (call $write (local.get $out) (i32.load (local.get $entry)) (i32.load offset=4 (local.get $entry)))
      (call $write (local.get $out) (i32.const 0) (i32.const 1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $each)))
    (call $get_environment (i32.const 64))
    (local.set $list (i32.load (i32.const 64)))
    (local.set $count (i32.load (i32.const 68)))
    (local.set $i (i32.const 0))
    (block $done (loop $each
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $entry (i32.add (local.get $list) (i32.shl (local.get $i) (i32.const 4))))
      (call $write (local.get $out) (i32.load (local.get $entry)) (i32.load offset=4 (local.get $entry)))
      (call $write (local.get $out) (i32.const 16) (i32.const 1))
      (call $write (local.get $out) (i32.load offset=8 (local.get $entry)) (i32.load offset=12 (local.get $entry)))
      (call $write (local.get $out) (i32.const 0) (i32.const 1))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $each)))
    (if (i64.ne (call $now) (i64.const 0))
      (then (call $write (local.get $out) (i32.const 48) (i32.const 2))))
    (call $write (local.get $out) (i32.const 32) (i32.const 4))
    (call $drop_output (local.get $out))
    (call $exit (i32.const 1)))

  (func (export "run") (call $main))
  (func (export "wasi:cli/run@0.2.6#run") (result i32) (call $main) (i32.const 0)))
